    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./src",
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "plugins": [{ "name": "@nestjs/swagger/plugin" }]
  },
  "include": ["src/**/*.ts"]
}
