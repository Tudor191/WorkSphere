PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

DATABASE_URL="postgresql://worksphere_app:CHANGE_ME@localhost:5432/worksphere?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="CHANGE_ME_dev_only_secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# AI Assistant — necompletat = funcția e dezactivată (răspuns clar, nu crash).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Stripe billing — necompletat = funcția e dezactivată (răspuns clar, nu crash).
# Chei de TEST MODE (sk_test_...) — vezi docs/ROADMAP.md pentru cum se
# configurează local (Stripe CLI pentru webhook-uri, script de setup pentru
# produse/prețuri).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
FRONTEND_URL="http://localhost:3000"

# Firebase Cloud Messaging (push) — necompletat = doar push-ul e dezactivat;
# notificările rămân vizibile în aplicație. Valorile vin din JSON-ul de
# service account (Firebase Console → Project settings → Service accounts →
# Generate new private key).
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Twilio (SMS) — necompletat = SMS-ul e dezactivat; restul notificărilor
# (in-app, push) nu sunt afectate. Necesită și ca userul să aibă un
# `phone` setat + `smsNotificationsEnabled` activat din cont — vezi
# docs/ROADMAP.md.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Resend (email tranzacțional — bun venit la înregistrare) — necompletat =
# trimiterea de email-uri e dezactivată, restul fluxului (înregistrare,
# login) nu e afectat. Cont gratuit: https://resend.com (100 email-uri/zi).
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="WorkSphere <onboarding@resend.dev>"
