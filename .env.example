# Variabile folosite de docker-compose.yml (deploy). Pentru dezvoltare
# locală, fiecare app are propriul .env — vezi apps/api/.env.example și
# apps/web/.env.example.

POSTGRES_USER=worksphere
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=worksphere

JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_-hex_32

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Integrări opționale (AI Assistant, plăți, push, SMS) — necompletate =
# funcțiile respective sunt dezactivate, restul aplicației pornește normal.
# Detalii per variabilă în apps/api/.env.example.
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
